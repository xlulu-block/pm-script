PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# PRIVATE_KEY is optional for dry-run, required for real order placement.
# 0 = normal EOA wallet (MetaMask / OKX / Rabby private key)
# 1 = Polymarket proxy/profile wallet (email login / profile address funder)
# 2 = actual Polymarket Gnosis Safe account only
# SIGNATURE_TYPE=0
# If SIGNATURE_TYPE is 1 or 2, set this to the wallet that actually holds the Polymarket collateral.
# For SIGNATURE_TYPE=1 this is usually your Polymarket profile / funder address.
# Do not use SIGNATURE_TYPE=2 for a normal wallet private key plus profile address setup.
# FUNDER_ADDRESS=0xYOUR_POLYMARKET_PROFILE_ADDRESS
# If SIGNATURE_TYPE is 0, do not set FUNDER_ADDRESS.
# Polygon RPC used for one-time on-chain USDC.e approvals when SIGNATURE_TYPE=0.
# If omitted, the script tries a few public Polygon RPCs and picks the first working one.
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# For EOA wallets, auto-approve the required Polymarket spenders if allowance is missing.
# AUTO_APPROVE_COLLATERAL=true
# Polygon approval transactions sometimes need a higher tip on Polygon.
# POLYGON_MIN_PRIORITY_FEE_GWEI=30
# Proxy (required in China / behind GFW):
# HTTPS_PROXY=http://127.0.0.1:7890
# If your system proxy is wrong and you want direct access:
# DISABLE_PROXY=true
# Optional overrides:
# FILTER_PROFILE=historical_winners
# ORDER_PRICE=0.001
# ORDER_SIZE=100
# DEPTH_MULTIPLIER=3
# BUY_DEPTH_DEBOUNCE_MS=3000
# POST_ONLY=true
# STRICT_ORDERBOOK_CHECK=true
# SELL_DEPTH_DEBOUNCE_MS=3000
# SELL_SCAN_CONCURRENCY=12
# ORDER_BATCH_SIZE=10
# ORDER_BATCH_MIN_SIZE=1
# ORDER_BATCH_MAX_RETRIES=3
# ORDER_BATCH_RETRY_BASE_MS=1000
# DRY_RUN=false
# RUN_FOREVER=true
# SCAN_INTERVAL_MS=3600000
# ORDER_DELAY_MS=500
# PAGE_SIZE=100
# MAX_PAGES=300
# FETCH_TIMEOUT_MS=15000
# STATE_FILE=scanner-state.json
# ERROR_LOG_FILE=order-errors.jsonl
